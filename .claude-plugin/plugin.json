{
  "name": "outgrow",
  "version": "1.1.0",
  "description": "Explains technical output in plain English, tells you whether you are actually broken, flags anything that costs money or cannot be undone, and stops explaining each term once you have learned it.",
  "author": {
    "name": "Rakshit-Droid",
    "url": "https://github.com/Rakshit-Droid"
  },
  "homepage": "https://github.com/Rakshit-Droid/outgrow",
  "repository": "https://github.com/Rakshit-Droid/outgrow",
  "license": "MIT",
  "keywords": [
    "beginners",
    "plain-english",
    "explanation",
    "learning",
    "vibe-coding"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\"",
            "timeout": 5,
            "statusMessage": "Switching outgrow on..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/prompt.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
